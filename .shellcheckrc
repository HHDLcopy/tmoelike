# tmoelike ShellCheck 配置（CI 以 -S warning 运行）
shell=bash
# 模块按 TMOE_LIB 动态 source，静态分析看不到跨文件定义/使用
external-sources=false
# SC1090/SC1091 动态 source 路径无法解析
# SC2034     模块化后跨文件的全局变量（TUI/TMOE_VERSION/REGISTRY 等）被误判未使用
# SC2155     local x=$(cmd) —— 本项目有意分离声明与赋值
# SC2317     source 加载的函数在单文件分析时看似不可达
disable=SC1090,SC1091,SC2034,SC2155,SC2317
